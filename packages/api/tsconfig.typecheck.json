{
  // Type-checks everything under src, tests included; emits nothing.
  // The build config excludes src/__tests__ so tests stay out of dist.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src"],
  "exclude": []
}
