{
  "name": "@diet-app/db",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx scripts/db-migrate.ts",
    "studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "import-products": "tsx scripts/import-products-cli.ts",
    "db:seed": "node scripts/generate-ingredients.mjs && tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "setup:test-db": "bash scripts/setup-test-db.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.9",
    "@types/pg": "^8.18.0",
    "@types/node": "^25.9.4",
    "vitest": "^4.1.9"
  }
}
