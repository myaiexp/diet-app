{
  // Standalone rather than extending tsconfig.base.json: this package emits
  // nothing (Vite builds it), needs the DOM lib, and type-checks its tests —
  // none of which the shared Node/emit config expresses.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["src", "vite.config.ts"]
}
