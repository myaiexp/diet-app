# Diet App API. Live copy: /etc/systemd/system/diet-app-api.service
# After editing: sudo cp systemd/diet-app-api.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl restart diet-app-api
[Unit]
Description=Diet App API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=mase
WorkingDirectory=/home/mase/Projects/diet-app
ExecStart=/usr/bin/node packages/api/dist/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
EnvironmentFile=/home/mase/Projects/diet-app/.env

# Defense-in-depth against a future RCE in the Node process. Bind is already
# loopback-only and .env is mode 600. Do not add MemoryDenyWriteExecute — V8
# JIT needs W^X pages.
# ProtectHome=tmpfs (not yes): yes overmounts /home and hides a BindReadOnlyPaths
# target underneath it. tmpfs + the bind keeps only this tree reachable;
# sibling .env files and ~/.ssh stay invisible. EnvironmentFile is read by
# PID 1 as root, not by the service. load-env.ts re-reads the in-tree .env.
# IPAddressDeny mirrors the ranges packages/api/src/ai/ssrf-host.ts blocks for
# recipe import, minus loopback: 0.0.0.0/8 (a connect to 0.0.0.0 lands on
# 127.0.0.1), RFC1918, CGNAT, link-local/IMDS, 192.0.0.0/24, 198.18.0.0/15,
# multicast and 240/4; IPv6 ULA, link-local, site-local, multicast, 6to4,
# Teredo and local-use NAT64. Loopback (Postgres, systemd-resolved) and public
# HTTP(S) (import / AI) stay allowed. Do not deny 127.0.0.0/8 or ::1. Add a
# range here when ssrf-host.ts gains one; diet-app-api-service.test.ts pins it.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/mase/Projects/diet-app
IPAddressDeny=0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.168.0.0/16 198.18.0.0/15 224.0.0.0/4 240.0.0.0/4 fc00::/7 fe80::/10 fec0::/10 ff00::/8 2002::/16 2001::/32 64:ff9b:1::/48
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=1G

[Install]
WantedBy=multi-user.target
