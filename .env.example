DATABASE_URL=postgresql://dietapp:YOUR_PASSWORD@localhost:5433/dietapp
# Isolated test database (peer auth, mase user) — tests MUST use this, never DATABASE_URL (prod).
# Provision (create + migrate + seed + grant dietapp role): pnpm --filter @diet-app/db setup:test-db
TEST_DATABASE_URL=postgresql://mase@/dietapp_test?host=/var/run/postgresql
API_PORT=3300
# Shared secret gating every /api/* route except /api/health. REQUIRED — the
# server exits on startup if unset. Clients send `Authorization: Bearer <token>`.
# Generate one with: openssl rand -hex 32
API_TOKEN=
# Comma-separated CORS allowlist. Unset/empty => production-safe default
# (https://mase.fi only). For local dev, add the Vite origin:
# CORS_ORIGINS=https://mase.fi,http://localhost:5173
CORS_ORIGINS=
# Optional OpenAI-compatible AI client (recipe import). All three of
# AI_API_KEY, AI_BASE_URL, and AI_MODEL_CAPABLE must be non-empty for
# POST /api/recipes/import; otherwise import returns 503 and the server still
# boots. AI_MODEL_FAST is reserved for later slices. These MUST stay empty
# here: put real values only in .env (gitignored). AI_API_KEY is a high-value
# secret; never commit a populated value to .env.example.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL_FAST=
AI_MODEL_CAPABLE=
